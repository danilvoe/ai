{
  "base_url": "https://openai.bothub.chat/v1",
  "api_key": "your-api-key",
  "temperature": 0.7,
  "max_context_tokens": 65536,
  "compression": {
    "keep_recent": 10,
    "summarize_every": 10,
    "max_tokens": 400
  },
  "context": {
    "strategy": "sticky_facts",
    "window_size": 10,
    "max_facts": 30,
    "size": 10
  },
  "memory": {
    "enabled": true,
    "profile_path": "history/profile.json"
  },
  "personalization": {
    "enabled": true,
    "profiles_path": "history/profiles.json"
  },
  "task": {
    "enabled": true,
    "auto_advance": true,
    "strict": true
  },
  "invariants": {
    "enabled": true,
    "path": "history/invariants.json",
    "enforce": true
  },
  "mcp": {
    "url": "https://developer.auroraos.ru/api/mcp",
    "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
    "timeout": 30
  },
  "tools": {
    "enabled": true,
    "command": "python3",
    "args": ["mcp/gitflic_server.py"],
    "gitflic_token": "your-gitflic-access-token",
    "gitflic_api_url": "https://api.gitflic.ru",
    "timeout": 60
  },
  "pipeline": {
    "enabled": true,
    "command": "python3",
    "args": ["mcp/pipeline_server.py"],
    "output_path": "history/pipeline_result.md",
    "timeout": 60
  },
  "input_cost_per_million": 1.0,
  "output_cost_per_million": 2.0,
  "models": [
    {
      "label": "Слабая",
      "model": "model-id-from-bothub",
      "input_cost_per_million": 0,
      "output_cost_per_million": 0
    },
    {
      "label": "Средняя",
      "model": "model-id-from-bothub",
      "input_cost_per_million": 0,
      "output_cost_per_million": 0
    },
    {
      "label": "Сильная",
      "model": "model-id-from-bothub",
      "input_cost_per_million": 0,
      "output_cost_per_million": 0
    }
  ]
}
