{
  "base_url": "https://openai.bothub.chat/v1",
  "api_key": "your-api-key",
  "temperature": 0.7,
  "timeout": 120,
  "max_retries": 2,
  "max_context_tokens": 65536,
  "compression": {
    "keep_recent": 10,
    "summarize_every": 10,
    "max_tokens": 400
  },
  "context": {
    "strategy": "sticky_facts",
    "window_size": 10,
    "max_facts": 30,
    "size": 10
  },
  "memory": {
    "enabled": true,
    "profile_path": "history/profile.json"
  },
  "personalization": {
    "enabled": true,
    "profiles_path": "history/profiles.json"
  },
  "task": {
    "enabled": true,
    "auto_advance": true,
    "strict": true
  },
  "invariants": {
    "enabled": true,
    "path": "history/invariants.json",
    "enforce": true
  },
  "mcp": {
    "url": "https://developer.auroraos.ru/api/mcp",
    "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
    "timeout": 30
  },
  "tools": {
    "enabled": true,
    "command": "python3",
    "args": ["mcp/gitflic_server.py"],
    "gitflic_token": "your-gitflic-access-token",
    "gitflic_api_url": "https://api.gitflic.ru",
    "timeout": 60
  },
  "pipeline": {
    "enabled": true,
    "command": "python3",
    "args": ["mcp/pipeline_server.py"],
    "output_path": "history/pipeline_result.md",
    "timeout": 60
  },
  "orchestrator": {
    "enabled": true,
    "max_steps": 6,
    "servers": [
      {
        "name": "gitflic",
        "command": "python3",
        "args": ["mcp/gitflic_server.py"],
        "env": {
          "GITFLIC_TOKEN": "your-gitflic-access-token",
          "GITFLIC_API_URL": "https://api.gitflic.ru",
          "GITFLIC_MAX_PAGES": "2"
        }
      },
      {
        "name": "pipeline",
        "command": "python3",
        "args": ["mcp/pipeline_server.py"]
      },
      {
        "name": "report",
        "command": "python3",
        "args": ["mcp/report_server.py"]
      }
    ]
  },
  "indexing": {
    "enabled": true,
    "source_path": "recipt_sample.json",
    "index_dir": "history/index",
    "embedder": "local",
    "embedding_dim": 256,
    "chunk_size": 400,
    "chunk_overlap": 80,
    "top_k": 5
  },
  "rag": {
    "enabled": true,
    "dataset": "recipt_all",
    "strategy": "structural",
    "top_k": 5,
    "max_context_chars": 6000,
    "temperature": 0.2,
    "report_dir": "history/rag"
  },
  "reranking": {
    "enabled": true,
    "dataset": "recipt_all",
    "strategy": "structural",
    "retrieve_k": 15,
    "final_k": 5,
    "min_score": 0.33,
    "score_ratio": 0.0,
    "min_keep": 1,
    "method": "heuristic",
    "rewrite": "heuristic",
    "weights": {
      "vector": 0.50,
      "lexical": 0.30,
      "title": 0.15,
      "section": 0.05
    },
    "temperature": 0.2,
    "report_dir": "history/rag_rerank"
  },
  "grounding": {
    "enabled": true,
    "dataset": "recipt_all",
    "strategy": "structural",
    "relevance_threshold": 0.33,
    "top_k": 5,
    "max_context_chars": 6000,
    "temperature": 0.2,
    "report_dir": "history/rag_grounding"
  },
  "local_llm": {
    "enabled": true,
    "llama_dir": "history/llama.cpp",
    "model_path": "history/models/qwen2.5-3b-instruct-q4_k_m.gguf",
    "host": "127.0.0.1",
    "port": 8080,
    "ctx_size": 8192,
    "threads": 8,
    "n_gpu_layers": 0,
    "max_response_tokens": 1024,
    "startup_timeout": 120,
    "model_label": "local-llm",
    "presets": {
      "baseline": {"temperature": 0.7, "max_tokens": 1024, "context_window": 8},
      "optimized": {"temperature": 0.2, "max_tokens": 384, "context_window": 6}
    },
    "variants": [
      {
        "label": "Q4_K_M",
        "quantization": "Q4_K_M",
        "model_path": "history/models/qwen2.5-3b-instruct-q4_k_m.gguf",
        "size_mb": 2100,
        "tokens_per_sec": 25,
        "ram_mb": 2600,
        "ctx_size": 8192
      },
      {
        "label": "Q2_K",
        "quantization": "Q2_K",
        "model_path": "history/models/qwen2.5-3b-instruct-q2_k.gguf",
        "size_mb": 1150,
        "tokens_per_sec": 40,
        "ram_mb": 1600,
        "ctx_size": 8192
      }
    ]
  },
  "web_chat": {
    "host": "127.0.0.1",
    "port": 8000,
    "window_size": 8,
    "max_sessions": 64
  },
  "local_rag": {
    "enabled": true,
    "dataset": "recipt_all",
    "strategy": "structural",
    "top_k": 5,
    "max_context_chars": 6000,
    "temperature": 0.2,
    "relevance_threshold": 0.33,
    "history_max_chars": 2000,
    "generic_threshold": 0.25,
    "generic_min_sources": 3,
    "category_suggestions": 5,
    "repeats": 2,
    "report_dir": "history/local_rag"
  },
  "optimization": {
    "enabled": true,
    "repeats": 2,
    "default_preset": "",
    "default_prompt_template": "baseline",
    "report_dir": "history/optimization",
    "configurations": [
      {
        "name": "baseline",
        "label": "До оптимизации",
        "preset": "baseline",
        "prompt_template": "baseline",
        "variant": "Q4_K_M"
      },
      {
        "name": "optimized",
        "label": "После: параметры + промпт",
        "preset": "optimized",
        "prompt_template": "recipe_structured",
        "variant": "Q4_K_M"
      },
      {
        "name": "quantized",
        "label": "После + квант Q2_K",
        "preset": "optimized",
        "prompt_template": "recipe_structured",
        "variant": "Q2_K"
      }
    ]
  },
  "dev_assistant": {
    "enabled": true,
    "index_dir": "history/index",
    "dataset": "project_docs",
    "strategy": "markdown",
    "top_k": 5,
    "min_score": 0.0,
    "temperature": 0.2,
    "max_context_chars": 6000,
    "chunk_size": 700,
    "overlap": 120,
    "report_dir": "history/dev_assistant",
    "project_server": {
      "enabled": true,
      "command": "python3",
      "args": ["mcp/project_server.py"],
      "timeout": 30
    }
  },
  "input_cost_per_million": 1.0,
  "output_cost_per_million": 2.0,
  "models": [
    {
      "label": "Слабая",
      "model": "model-id-from-bothub",
      "input_cost_per_million": 0,
      "output_cost_per_million": 0
    },
    {
      "label": "Средняя",
      "model": "model-id-from-bothub",
      "input_cost_per_million": 0,
      "output_cost_per_million": 0
    },
    {
      "label": "Сильная",
      "model": "model-id-from-bothub",
      "input_cost_per_million": 0,
      "output_cost_per_million": 0
    }
  ]
}
